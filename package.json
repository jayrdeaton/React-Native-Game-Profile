{
  "name": "@tastic/profile",
  "version": "0.1.1",
  "description": "Player profile identity for local-multiplayer React Native games — a saved name/color/tag a player selects per seat, with a picker, an inline-editable roster screen, and a reusable identity badge, deliberately blind to any app-specific fields (control scheme, stats) an app layers on top",
  "keywords": [
    "react-native",
    "expo",
    "local-multiplayer",
    "couch-multiplayer",
    "profile",
    "player-identity",
    "avatar"
  ],
  "homepage": "https://github.com/jayrdeaton/react-native-game-profile#readme",
  "bugs": {
    "url": "https://github.com/jayrdeaton/react-native-game-profile/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jayrdeaton/react-native-game-profile.git"
  },
  "license": "MIT",
  "author": "Jay Deaton",
  "sideEffects": false,
  "type": "commonjs",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "browser": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "react-native": "src/index.ts",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/__tests__",
    "!src/__mocks__"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "build:watch": "tsup src/index.ts --format cjs,esm --dts --watch",
    "ci": "npm run lint && npm test && npm run typecheck && npm run build",
    "fix": "eslint --fix",
    "lint": "eslint",
    "prepublishOnly": "npm run build",
    "release": "git push --follow-tags",
    "release:major": "npm version major && npm run release",
    "release:minor": "npm version minor && npm run release",
    "release:patch": "npm version patch && npm run release",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "typecheck": "tsc --noEmit",
    "preversion": "npm run ci"
  },
  "prettier": "@infinitetoken/eslint-config/prettier",
  "devDependencies": {
    "@infinitetoken/eslint-config": "^0.1.4",
    "@infinitetoken/tsconfig": "^0.1.1",
    "@rific/auto-paper": "^0.10.1",
    "@rific/feedback-press": "^0.10.7",
    "@rific/focus-chain": "^0.4.4",
    "@rific/toaster": "^0.6.0",
    "@tastic/core": "^0.1.3",
    "@tastic/hud": "^0.1.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.8.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "^0.85.3",
    "react-native-paper": "^5.15.2",
    "react-native-safe-area-context": "^5.0.0",
    "ts-jest": "^29.4.9",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@rific/auto-paper": ">=0.9.0",
    "@rific/feedback-press": ">=0.10.0",
    "@rific/focus-chain": ">=0.4.0",
    "@rific/toaster": ">=0.4.0",
    "@tastic/core": ">=0.1.0",
    "@tastic/hud": ">=0.1.3",
    "react": ">=19.0.0",
    "react-native": ">=0.76.0",
    "react-native-paper": ">=5.0.0",
    "react-native-safe-area-context": ">=4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
